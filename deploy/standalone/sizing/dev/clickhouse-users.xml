<?xml version="1.0"?>
<!--
  Query settings for SIZING_PROFILE=dev. The server-side half, and where
  this tuning comes from, is in clickhouse.xml next to it.

  Applies to the `default` profile, which is the one the image's entrypoint
  gives the user it creates from CLICKHOUSE_USER, so it covers every SigNoz
  query and every collector insert. Mounted as users.d/zz-sizing.xml.
-->
<clickhouse>
    <profiles>
        <default>
            <!-- "Lower the number of query processing threads down to 1."
                 Per-query memory scales with threads. -->
            <max_threads>1</max_threads>
            <!-- "Lower the max_block_size to 8192." -->
            <max_block_size>8192</max_block_size>
            <!-- "Lower max_download_threads to 1." -->
            <max_download_threads>1</max_download_threads>
            <!-- "Set input_format_parallel_parsing and
                 output_format_parallel_formatting to 0." -->
            <input_format_parallel_parsing>0</input_format_parallel_parsing>
            <output_format_parallel_formatting>0</output_format_parallel_formatting>
        </default>
    </profiles>
</clickhouse>
