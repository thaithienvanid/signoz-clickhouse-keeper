# Container limits for SIZING_PROFILE=dev: one machine, low ingest.
# scripts/apply-sizing.sh writes these into .env. Measured basis:
# docs/standalone.md#sizing.
SIZING_PROFILE=dev
CLICKHOUSE_MEMORY_LIMIT=1g
CLICKHOUSE_CPU_LIMIT=1
COLLECTOR_MEMORY_LIMIT=256m
COLLECTOR_CPU_LIMIT=1
SIGNOZ_MEMORY_LIMIT=384m
SIGNOZ_CPU_LIMIT=1
KEEPER_MEMORY_LIMIT=256m
KEEPER_CPU_LIMIT=0.5
MEMORY_LIMITER_MIB=200
MEMORY_LIMITER_SPIKE_MIB=40
