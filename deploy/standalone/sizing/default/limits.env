# Container limits for SIZING_PROFILE=default, as in .env.example.
# scripts/apply-sizing.sh writes these into .env; scripts/validate.sh fails if
# they drift from .env.example.
SIZING_PROFILE=default
CLICKHOUSE_MEMORY_LIMIT=8g
CLICKHOUSE_CPU_LIMIT=4
COLLECTOR_MEMORY_LIMIT=2g
COLLECTOR_CPU_LIMIT=2
SIGNOZ_MEMORY_LIMIT=2g
SIGNOZ_CPU_LIMIT=2
KEEPER_MEMORY_LIMIT=1g
KEEPER_CPU_LIMIT=1
MEMORY_LIMITER_MIB=1600
MEMORY_LIMITER_SPIKE_MIB=320
