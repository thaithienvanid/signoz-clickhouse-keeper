# ─────────────────────────────────────────────────────────────────────────────
# SigNoz standalone — image versions and deployment settings
#
# Copy to `.env` and edit:  cp .env.example .env
# `.env` is git-ignored because it holds the ClickHouse password.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image versions ───────────────────────────────────────────────────────────
# ClickHouse is a HARD PIN, not a "latest available" choice.
# SigNoz's own compatibility matrix (SigNoz/foundry, internal/compat/installation)
# declares: collector > 0.144.5  REQUIRES clickhouse = 25.12.5.
# Do not bump ClickHouse past this until SigNoz widens that rule, even though
# newer ClickHouse tags exist on Docker Hub.
CLICKHOUSE_VERSION=25.12.5
CLICKHOUSE_KEEPER_VERSION=25.12.5

# SigNoz components. Always pin in production; `latest` only for throwaway envs.
# The collector and the schema migrations ship from the same image, so keep
# SIGNOZ_OTEL_COLLECTOR_VERSION consistent everywhere.
SIGNOZ_VERSION=v0.136.1
SIGNOZ_OTEL_COLLECTOR_VERSION=v0.144.8

# ── ClickHouse credentials ───────────────────────────────────────────────────
# The official ClickHouse image locks the built-in `default` user to localhost
# unless CLICKHOUSE_USER/CLICKHOUSE_PASSWORD are set, which would leave SigNoz
# unable to connect. Setting these creates a network-reachable user instead.
# CHANGE THIS before any deployment that is not a laptop:
#   openssl rand -base64 24
CLICKHOUSE_USER=signoz
CLICKHOUSE_PASSWORD=change-me-before-deploying

# ── Published ports ──────────────────────────────────────────────────────────
# Bound to 127.0.0.1 by default so nothing is reachable off-box until you
# deliberately put a TLS-terminating proxy in front. Use 0.0.0.0 to expose.
BIND_ADDRESS=127.0.0.1
SIGNOZ_UI_PORT=8080
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ── Resource limits ──────────────────────────────────────────────────────────
# Keep MEMORY_LIMITER_MIB at roughly 80% of COLLECTOR_MEMORY_LIMIT, and
# COLLECTOR_MEMORY_LIMIT comfortably under the host's free memory.
CLICKHOUSE_MEMORY_LIMIT=8g
CLICKHOUSE_CPU_LIMIT=4
COLLECTOR_MEMORY_LIMIT=2g
COLLECTOR_CPU_LIMIT=2
SIGNOZ_MEMORY_LIMIT=2g
SIGNOZ_CPU_LIMIT=2
KEEPER_MEMORY_LIMIT=1g
KEEPER_CPU_LIMIT=1

# ── Collector tuning ─────────────────────────────────────────────────────────
# Group exceptions with low-cardinality grouping keys. Cheaper storage, coarser
# exception grouping in the UI.
LOW_CARDINAL_EXCEPTION_GROUPING=false

# Soft memory ceiling for the collector's memory_limiter processor, in MiB.
# Set to ~80% of COLLECTOR_MEMORY_LIMIT so the processor starts shedding load
# before the container hits its cgroup limit and gets OOM-killed.
MEMORY_LIMITER_MIB=1600
MEMORY_LIMITER_SPIKE_MIB=320
