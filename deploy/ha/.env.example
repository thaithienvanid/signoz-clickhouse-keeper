# ─────────────────────────────────────────────────────────────────────────────
# SigNoz HA — image versions and deployment settings
#
#   cp .env.example .env && $EDITOR .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Image versions ───────────────────────────────────────────────────────────
# ClickHouse is a HARD PIN: SigNoz declares collector > 0.144.5 requires
# clickhouse = 25.12.5. See ../standalone/.env.example for the full rationale.
CLICKHOUSE_VERSION=25.12.5
CLICKHOUSE_KEEPER_VERSION=25.12.5
SIGNOZ_VERSION=v0.136.1
SIGNOZ_OTEL_COLLECTOR_VERSION=v0.144.8
POSTGRES_VERSION=16-alpine
NGINX_VERSION=1.29-alpine

# ── ClickHouse credentials ───────────────────────────────────────────────────
#   openssl rand -base64 24
CLICKHOUSE_USER=signoz
CLICKHOUSE_PASSWORD=change-me-before-deploying

# ── Metastore ────────────────────────────────────────────────────────────────
# HA runs more than one SigNoz backend, and SQLite cannot be shared between
# them. Postgres is required here, not optional.
POSTGRES_USER=signoz
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=signoz

# ── Published ports (load balancer only) ─────────────────────────────────────
# Individual backends and collectors are never published; all traffic enters
# through nginx.
BIND_ADDRESS=127.0.0.1
SIGNOZ_UI_PORT=8080
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ── Resource limits ──────────────────────────────────────────────────────────
# Sized for a single beefy host running the whole simulated cluster. On real
# multi-host hardware, raise CLICKHOUSE_MEMORY_LIMIT substantially.
CLICKHOUSE_MEMORY_LIMIT=8g
CLICKHOUSE_CPU_LIMIT=4
KEEPER_MEMORY_LIMIT=1g
KEEPER_CPU_LIMIT=1
COLLECTOR_MEMORY_LIMIT=2g
COLLECTOR_CPU_LIMIT=2
SIGNOZ_MEMORY_LIMIT=2g
SIGNOZ_CPU_LIMIT=2

# ── Collector tuning ─────────────────────────────────────────────────────────
LOW_CARDINAL_EXCEPTION_GROUPING=false
MEMORY_LIMITER_MIB=1600
MEMORY_LIMITER_SPIKE_MIB=320
